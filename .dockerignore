# 依赖（容器内重新安装，避免把宿主机的原生模块带进 Linux 镜像）
node_modules
npm-debug.log

# 环境变量
.env
.env.local

# 数据库及运行时文件（通过 volume 持久化到宿主机根目录 database.sqlite）
database.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# 日志
logs
*.log

# 版本控制
.git
.gitignore

# 编辑器 / IDE
.vscode
.idea

# 操作系统
.DS_Store
Thumbs.db

# 文档与脚本（构建镜像不需要）
README.md
run.sh
self_test.txt

# 对话记录与题目
对话
题目.md

# 备份/临时目录
webtemp
